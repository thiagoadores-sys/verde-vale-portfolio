# Copie para .env.local e preencha. NUNCA commite o .env.local.

# Públicas (vão para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... ou anon key legada>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Este projeto NÃO usa a chave secreta (service_role) no app.
# Se um dia precisar, use só no servidor e sem o prefixo NEXT_PUBLIC_:
# SUPABASE_SECRET_KEY=
